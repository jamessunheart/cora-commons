{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamessunheart/cora-commons/blob/main/CONTRIBUTIONS/schema/receipt.schema.json",
  "title": "Cora Commons Contribution Receipt 0.1",
  "type": "object",
  "required": ["schema_version", "receipt_id", "status", "need_id", "agreement_url", "contributors", "artifact", "delivery", "review", "reward", "events"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^CR-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "status": {"enum": ["ACCEPTED", "REUSED", "IMPACT_VERIFIED", "REWARD_ALLOCATED"]},
    "need_id": {"type": "string", "minLength": 1},
    "agreement_url": {"type": "string", "minLength": 1},
    "contributors": {"type": "array", "minItems": 1},
    "artifact": {"type": "object"},
    "delivery": {"type": "object"},
    "review": {"type": "object"},
    "reward": {"type": "object"},
    "events": {"type": "array", "minItems": 2}
  },
  "additionalProperties": false
}
